# ---------------------------------------------------------------------------
# 複製成 .env 後填值。docker compose 的 db/redis 主機名已在 compose 內覆寫，
# 若要在容器外直接 npm run dev，請把 db/redis 改成 localhost。
# ---------------------------------------------------------------------------

# --- 應用 ---
# 對外的完整網址。綠界所有 callback 都由此組出來，必須是綠界連得到的公開網址。
# 本機開發：docker compose --profile tunnel up -d cloudflared 後把 trycloudflare 網址填進來。
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- PostgreSQL 容器（docker-compose.prod.yml 用，compose 會讀這個檔做變數替換）---
POSTGRES_USER=sagon
POSTGRES_PASSWORD=sagon_dev_pw
POSTGRES_DB=sagon

# --- 資料庫 / 佇列 ---
# host 對外是 15433（避開其他 PostgreSQL 與 Windows 的動態保留埠 5150-5749）；
# 容器內 compose 會覆寫成 db:5432
DATABASE_URL=postgresql://sagon:sagon_dev_pw@localhost:15433/sagon?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=please-change-me-to-a-32-byte-random-string
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- 綠界共用 ---
# stage = 測試站, production = 正式站
ECPAY_ENV=stage

# --- 綠界 全方位金流 AIO（下列為官方測試站公開的測試帳號）---
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# --- 綠界 物流整合（只做超商取貨 C2C；宅配走黑貓自己的系統）---
# 綠界的超商申請類型分 B2C 與 C2C，兩者不共用商店代號也不能混串。
# 下列為 C2C 的官方測試帳號。
ECPAY_LOGISTICS_MERCHANT_ID=2000933
ECPAY_LOGISTICS_HASH_KEY=XBERn1YOvpM9nfZc
ECPAY_LOGISTICS_HASH_IV=h1ONHk4P4yqbl5LK
# 寄件人資訊。超商 C2C 只會用到 NAME 與 CELLPHONE，
# NAME 限 4~10 字元且不可填公司名（否則退件時領不回來）；其餘欄位給黑貓出貨用。
ECPAY_SENDER_NAME=莎岡出貨組
ECPAY_SENDER_PHONE=0223456789
ECPAY_SENDER_CELLPHONE=0912345678
ECPAY_SENDER_ZIPCODE=104
ECPAY_SENDER_ADDRESS=台北市中山區中山北路一段1號

# --- 綠界 電子收據 ---
# ⚠️ 電子收據不是統一發票，不能報稅抵扣。紙本發票由人工開立、隨包裹寄出。
ECPAY_RECEIPT_MERCHANT_ID=2000132
ECPAY_RECEIPT_HASH_KEY=ejCk326UnaZWKisg
ECPAY_RECEIPT_HASH_IV=q9jcZX8Ib9LM8wYk
# 是否在付款成功後自動開立收據
ECPAY_RECEIPT_AUTO_ISSUE=true

# --- 黑貓宅急便（統一速達 印單 API）---
# 宅配是我們自己跟黑貓簽的約，不經綠界。超商取貨才走綠界。
# 授權碼到契客專區取得：https://www.takkyubin.com.tw/YMTContract/aspx/Login.aspx
TCAT_ENV=stage
# 契客代號，規格限 10 碼或 12 碼（E007）。
# 注意契客專區的下拉可能顯示成補到 12 碼的樣子（例如 10 碼後面多兩位），
# 以黑貓給你的契客代號為準，不確定就打 02-26275861 問。
TCAT_CUSTOMER_ID=__CHANGE_ME__
TCAT_CUSTOMER_TOKEN=__CHANGE_ME__
# ⚠️ 這是「黑貓郵碼」的後六碼，不是中華郵政的郵遞區號。
# 用 npx tsx scripts/tcat-parse-address.ts "你的寄件地址" 查一次填進來即可。
TCAT_SENDER_ZIP=__CHANGE_ME__
# 託運單版型：01 A4二模、02 A4三模、03 熱轉印（熱轉印需要標籤機）
TCAT_OBT_TYPE=01
# 商品類別，0008 = 服飾配件。完整清單見規格書 2.2.1 第 32 項
TCAT_PRODUCT_TYPE_ID=0008
# 材積級距：0001 60cm、0002 90cm、0003 120cm、0004 150cm
TCAT_DEFAULT_SPEC=0002
# 每滿幾件把材積升一級。預設 9999 = 一律用 TCAT_DEFAULT_SPEC
TCAT_SPEC_QTY_STEP=9999

# --- 簡訊 OTP ---
# console = 開發用，OTP 印在 log 並寫入 DB；mitake = 三竹
SMS_PROVIDER=console
MITAKE_USERNAME=
MITAKE_PASSWORD=

# --- Email ---
# Windows + Docker Desktop 請用 127.0.0.1 而非 localhost（localhost 會先解析成 ::1，連得上卻不通）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="莎岡選品店 <no-reply@sagon.local>"

# --- Seed / 爬蟲 ---
# 設成 sagan 才會允許執行 scripts/scrape-sagan.ts（他人著作權素材，僅供本機開發）
SEED_SOURCE=
SEED_ADMIN_EMAIL=admin@sagon.local
SEED_ADMIN_PASSWORD=admin1234

# --- 商店設定 ---
SHOP_NAME=莎岡選品店
SHOP_TAX_ID=93124857
# 客服信箱。通知信頁尾、頁尾／關於／聯絡／常見問題與各政策頁都顯示這一個，
# 客戶會直接回信到這裡，一定要是收得到信的真信箱。
SHOP_SERVICE_EMAIL=ian890711@gmail.com
# 免運門檻與運費（新台幣）
SHIPPING_FEE_CVS=60
SHIPPING_FEE_HOME=120
FREE_SHIPPING_THRESHOLD=1500
# 未付款訂單保留庫存的分鐘數
STOCK_RESERVATION_MINUTES=30
