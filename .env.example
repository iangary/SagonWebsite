# ---------------------------------------------------------------------------
# 複製成 .env 後填值。docker compose 的 db/redis 主機名已在 compose 內覆寫，
# 若要在容器外直接 npm run dev，請把 db/redis 改成 localhost。
# ---------------------------------------------------------------------------

# --- 應用 ---
# 對外的完整網址。綠界所有 callback 都由此組出來，必須是綠界連得到的公開網址。
# 本機開發：docker compose --profile tunnel up -d cloudflared 後把 trycloudflare 網址填進來。
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- PostgreSQL 容器（docker-compose.prod.yml 用，compose 會讀這個檔做變數替換）---
POSTGRES_USER=sagon
POSTGRES_PASSWORD=sagon_dev_pw
POSTGRES_DB=sagon

# --- 資料庫 / 佇列 ---
# host 對外是 5433（避開機器上其他 PostgreSQL）；容器內 compose 會覆寫成 db:5432
DATABASE_URL=postgresql://sagon:sagon_dev_pw@localhost:5433/sagon?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=please-change-me-to-a-32-byte-random-string
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- 綠界共用 ---
# stage = 測試站, production = 正式站
ECPAY_ENV=stage

# --- 綠界 全方位金流 AIO（下列為官方測試站公開的測試帳號）---
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# --- 綠界 物流整合（C2C 與 B2C 的商店代號不同，測試站帳號請至綠界文件取得）---
ECPAY_LOGISTICS_MERCHANT_ID=2000132
ECPAY_LOGISTICS_HASH_KEY=5294y06JbISpM5x9
ECPAY_LOGISTICS_HASH_IV=v77hoKGq4kWxNNIS
# C2C 超商取貨需要，向綠界申請
ECPAY_LOGISTICS_C2C_MERCHANT_ID=2000933
ECPAY_LOGISTICS_C2C_HASH_KEY=XBERn1YOvpM9nfZc
ECPAY_LOGISTICS_C2C_HASH_IV=h1ONHk4P4yqbl5LK
# 寄件人資訊（建立物流訂單必填）
ECPAY_SENDER_NAME=莎岡選品店
ECPAY_SENDER_PHONE=0223456789
ECPAY_SENDER_CELLPHONE=0912345678
ECPAY_SENDER_ZIPCODE=104
ECPAY_SENDER_ADDRESS=台北市中山區中山北路一段1號

# --- 綠界 電子發票 B2C ---
ECPAY_INVOICE_MERCHANT_ID=2000132
ECPAY_INVOICE_HASH_KEY=ejCk326UnaZWKisg
ECPAY_INVOICE_HASH_IV=q9jcZX8Ib9LM8wYk
# 是否在付款成功後自動開立發票
ECPAY_INVOICE_AUTO_ISSUE=true

# --- 簡訊 OTP ---
# console = 開發用，OTP 印在 log 並寫入 DB；mitake = 三竹
SMS_PROVIDER=console
MITAKE_USERNAME=
MITAKE_PASSWORD=

# --- Email ---
# Windows + Docker Desktop 請用 127.0.0.1 而非 localhost（localhost 會先解析成 ::1，連得上卻不通）
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="莎岡選品店 <no-reply@sagon.local>"

# --- Seed / 爬蟲 ---
# 設成 sagan 才會允許執行 scripts/scrape-sagan.ts（他人著作權素材，僅供本機開發）
SEED_SOURCE=
SEED_ADMIN_EMAIL=admin@sagon.local
SEED_ADMIN_PASSWORD=admin1234

# --- 商店設定 ---
SHOP_NAME=莎岡選品店
SHOP_TAX_ID=93124857
# 通知信頁尾的客服信箱。正式環境要換成收得到信的真信箱。
SHOP_SERVICE_EMAIL=service@sagon.local
# 免運門檻與運費（新台幣）
SHIPPING_FEE_CVS=60
SHIPPING_FEE_HOME=120
FREE_SHIPPING_THRESHOLD=1500
# 未付款訂單保留庫存的分鐘數
STOCK_RESERVATION_MINUTES=30
