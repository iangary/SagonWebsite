# ---------------------------------------------------------------------------
# 正式環境。複製到主機的 /srv/sagon/.env.production 後填入真實值。
#
#   chmod 600 /srv/sagon/.env.production
#
# 注意這個檔是給「容器內的應用程式」用的（compose 的 env_file）。
# compose 檔案本身的 ${VAR} 替換讀的是另一個檔 —— /srv/sagon/.env，
# 內容見 docs/deploy.md 第 6 節。兩個檔缺一不可。
#
# 主機名稱用 compose 的服務名（db / redis），不是 localhost。
# ---------------------------------------------------------------------------

# --- 應用 ---
# 綠界所有 callback 都由此組出來，必須是 https 的正式網域
APP_URL=https://chenkuanyi.com.tw
NODE_ENV=production

# --- 資料庫 / 佇列 ---
# 密碼要和 /srv/sagon/.env 裡的 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql://sagon:__CHANGE_ME__@db:5432/sagon?schema=public
REDIS_URL=redis://redis:6379

# --- Auth.js ---
# 一定要重新產生，不要沿用開發用的值：openssl rand -base64 32
AUTH_SECRET=__CHANGE_ME__
AUTH_TRUST_HOST=true
# 選配。沒填的話登入頁不會顯示 Google 按鈕
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- 綠界共用 ---
# 正式站務必改成 production，並把下面所有金鑰換成綠界後台核發的正式值。
# 開發用的那組是綠界官方公開的測試帳號，放上正式站等於沒有金流。
ECPAY_ENV=production

# 三個服務的介接資訊都在綠界後台「系統設定 → 系統介接設定」，
# 同一個商店代號下金流、物流、電子收據可能共用同一組 HashKey/HashIV。

# --- 綠界 全方位金流 AIO ---
ECPAY_MERCHANT_ID=__CHANGE_ME__
ECPAY_HASH_KEY=__CHANGE_ME__
ECPAY_HASH_IV=__CHANGE_ME__

# --- 綠界 物流整合（只做超商取貨 C2C；宅配走黑貓自己的系統）---
# 綠界物流是預付制，帳戶餘額過低會無法建立物流單，上線前記得先儲值。
ECPAY_LOGISTICS_MERCHANT_ID=__CHANGE_ME__
ECPAY_LOGISTICS_HASH_KEY=__CHANGE_ME__
ECPAY_LOGISTICS_HASH_IV=__CHANGE_ME__

# 寄件人資訊。超商 C2C 只會用到 NAME 與 CELLPHONE，
# NAME 限 4~10 字元且不可填公司名（否則退件時領不回來）；其餘欄位給黑貓出貨用。
ECPAY_SENDER_NAME=__CHANGE_ME__
ECPAY_SENDER_PHONE=__CHANGE_ME__
ECPAY_SENDER_CELLPHONE=__CHANGE_ME__
ECPAY_SENDER_ZIPCODE=__CHANGE_ME__
ECPAY_SENDER_ADDRESS=__CHANGE_ME__

# --- 綠界 電子收據 ---
# ⚠️ 不是統一發票，不能報稅抵扣。紙本發票由人工開立、隨包裹寄出。
ECPAY_RECEIPT_MERCHANT_ID=__CHANGE_ME__
ECPAY_RECEIPT_HASH_KEY=__CHANGE_ME__
ECPAY_RECEIPT_HASH_IV=__CHANGE_ME__
ECPAY_RECEIPT_AUTO_ISSUE=true

# --- 黑貓宅急便（統一速達 印單 API）---
# 宅配是自簽契約，不經綠界。授權碼在契客專區用契客代號申請，會用簡訊發送：
# https://www.takkyubin.com.tw/YMTContract/aspx/Login.aspx →「取得印單API授權碼」→ 正式站台
TCAT_ENV=production
# 契客代號，規格限 10 碼或 12 碼（E007）。契客專區的下拉可能顯示成補滿 12 碼的樣子，
# 以黑貓核發給你的代號為準
TCAT_CUSTOMER_ID=__CHANGE_ME__
TCAT_CUSTOMER_TOKEN=__CHANGE_ME__
# ⚠️ 黑貓郵碼後六碼，不是中華郵政郵遞區號。查法：
#   npx tsx scripts/tcat-parse-address.ts "寄件地址"
TCAT_SENDER_ZIP=__CHANGE_ME__
TCAT_OBT_TYPE=01
TCAT_PRODUCT_TYPE_ID=0008
TCAT_DEFAULT_SPEC=0002
TCAT_SPEC_QTY_STEP=9999

# --- 簡訊 OTP ---
# console 只會把驗證碼印在 log，正式站必須改成 mitake
SMS_PROVIDER=mitake
MITAKE_USERNAME=__CHANGE_ME__
MITAKE_PASSWORD=__CHANGE_ME__

# --- Email ---
# 機房幾乎都封鎖 25 埠，不能用主機直接寄信。
# 以下為 Resend 的設定（免費 3,000 封/月），改用 SES/Mailgun 請自行調整。
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=__CHANGE_ME__
MAIL_FROM="莎岡選品店 <no-reply@chenkuanyi.com.tw>"

# --- Seed ---
# 正式站留空，避免誤觸爬蟲腳本
SEED_SOURCE=
SEED_ADMIN_EMAIL=__CHANGE_ME__
# 第一次啟動建立管理員後請立即從後台改密碼
SEED_ADMIN_PASSWORD=__CHANGE_ME__

# --- 商店設定 ---
SHOP_NAME=莎岡選品店
SHOP_TAX_ID=__CHANGE_ME__
# 通知信頁尾的客服信箱。必須是收得到信的真信箱 —— 客戶會直接回信到這裡。
SHOP_SERVICE_EMAIL=__CHANGE_ME__

# 運費。綠界實收：超商取貨（7-11／全家）65 元、黑貓宅配本島 130 元起。
# 設成 60/120 的話每單倒貼 5-10 元，滿額免運的單更是全額吸收。
SHIPPING_FEE_CVS=70
SHIPPING_FEE_HOME=140
FREE_SHIPPING_THRESHOLD=2000

# 未付款訂單保留庫存的分鐘數
STOCK_RESERVATION_MINUTES=30
